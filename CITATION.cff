cff-version: 1.2.0
message: "If you use this software, please cite it using the metadata from this file."
type: software
title: "GraphXSection"
abstract: >-
  Code for training and evaluating Graph Neural Network (GNN)-based models
  for predicting the Collisional Cross Section (CCS) of small molecules,
  including the creation of saliency maps to visually explain model
  predictions. GraphXSection is an implementation of Molgraph.
authors:
  - family-names: "Devreese"   
    given-names: "Robbe"   
    # orcid: "https://orcid.org/0000-0000-0000-0000"
    # affiliation: "Your institution"
repository-code: "https://github.com/rodvrees/GraphXSection"
url: "https://github.com/rodvrees/GraphXSection"
keywords:
  - collisional cross section
  - CCS prediction
  - ion mobility
  - graph neural networks
  - small molecules
  - saliency maps
  - cheminformatics
